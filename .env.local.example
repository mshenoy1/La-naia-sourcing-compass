# Copy this file to .env.local (already git-ignored via *.local) and fill in
# your own free Census Bureau API key to auto-populate the "Real Import Cost
# Data" panel on load, instead of pasting the key in each time.
#
# Get a free key (instant, no cost): https://api.census.gov/data/key_signup.html
VITE_CENSUS_API_KEY=
